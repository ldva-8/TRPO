root = true

[*.cs]
# Фигурные скобки для методов на той же строке
csharp_new_line_before_open_brace = true

# Фигурные скобки для типов (классов, структур) на той же строке
dotnet_diagnostic.IDE0055.severity = warning
csharp_new_line_before_open_brace = types, variables, properties, events, methods, control_blocks
